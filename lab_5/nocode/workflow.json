      "id": "6775c216-710d-44b3-add0-1ccb7db86174",
      "name": "HTML: Extract Book Links & Next Page",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        512,
        912
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.currentCategoryBooks) staticData.currentCategoryBooks = [];\n\nconst categoryName = $('Loop Over Items: Categories').first().json.categoryName;\nconst bookUrls = $json.bookUrls || [];\n\nbookUrls.forEach(url => {\n  let absoluteUrl = url;\n  if (!absoluteUrl.startsWith('http')) {\n    if (absoluteUrl.includes('../')) {\n      let cleanPath = absoluteUrl.replace(/^(\\.\\.\\/)+/, '');\n      absoluteUrl = 'https://books.toscrape.com/catalogue/' + cleanPath;\n    } else {\n      absoluteUrl = 'https://books.toscrape.com/' + absoluteUrl;\n    }\n  }\n  staticData.currentCategoryBooks.push({ bookUrl: absoluteUrl, categoryName: categoryName });\n});\n\nlet rawNextPage = $json.nextPageUrl;\nif (Array.isArray(rawNextPage)) rawNextPage = rawNextPage[0];\n\nlet nextPageUrl = '';\nlet hasNextPage = false;\n\nif (rawNextPage && typeof rawNextPage === 'string') {\n    let baseUrl = 'https://books.toscrape.com/';\n    try {\n        baseUrl = $('Code: Prepare Category URL').first().json.categoryUrl;\n    } catch (e) {}\n\n    const baseDir = baseUrl.substring(0, baseUrl.lastIndexOf('/') + 1);\n    nextPageUrl = baseDir + rawNextPage;\n    hasNextPage = true;\n}\n\nreturn [{ json: { nextPageUrl: nextPageUrl, hasNextPage: hasNextPage } }];"
      },
      "id": "7092f6de-8e88-413a-ae3e-d86323d4d010",
      "name": "Code: Accumulate Links & Check Next",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        912
      ]
    },
    {
      "parameters": {
