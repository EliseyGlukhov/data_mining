        "jsCode": "return items.map(item => {\n  const html = item.json.categoryHtml || '';\n  const urlMatch = html.match(/href=\"([^\"]+)\"/);\n  const nameMatch = html.match(/>([^<]+)<\\/a>/);\n  \n  return {\n    json: {\n      categoryUrl: urlMatch ? urlMatch[1] : '',\n      categoryName: nameMatch ? nameMatch[1].trim() : ''\n    }\n  };\n});"
      },
