      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.allBooks) staticData.allBooks = [];\nstaticData.allBooks.push(...items.map(i => i.json));\nreturn items;"
      },
