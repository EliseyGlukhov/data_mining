          "values": [
            {
              "key": "bookUrls",
              "cssSelector": "article.product_pod h3 a",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            },
            {
              "key": "nextPageUrl",
              "cssSelector": "li.next a",
              "returnValue": "attribute",
              "attribute": "href"
            }
          ]
        },
