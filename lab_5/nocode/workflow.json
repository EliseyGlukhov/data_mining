      "id": "f992eec3-8f06-4f00-83ad-964ca60db3b4",
      "name": "HTML: Extract Book Details",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1792,
        1184
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const j = item.json;\n  const price = parseFloat((j.priceExclTax || '').replace(/[^0-9.]/g, ''));\n  const reviews = parseInt((j.numberOfReviews || '0').replace(/[^0-9]/g, ''), 10);\n  const availability = (j.availability || '').toLowerCase().includes('in stock');\n\n  return {\n    json: {\n      upc: j.upc || '',\n      category: j.category || '',\n      title: j.title.replace(/\\s+/g, ' ').trim() || '',\n      priceExclTax: isNaN(price) ? null : price,\n      availability: availability,\n      numberOfReviews: isNaN(reviews) ? 0 : reviews\n    }\n  };\n});"
      },
      "id": "06281bab-1b44-4413-94ce-75b49537b27a",
